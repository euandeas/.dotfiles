# .bashrc

# Hafnium and Fedora defaults: bash completion, colours and the Starship prompt
# (all from /etc/profile.d). Fedora's own ~/.bashrc does the same.
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# User specific environment
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
    PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
export PATH

# Everything below is for interactive shells only
[[ $- != *i* ]] && return

# History control
shopt -s histappend
HISTCONTROL=ignoreboth
HISTSIZE=32768
HISTFILESIZE="${HISTSIZE}"

# File system
if command -v eza &> /dev/null; then
  alias ls='eza -lh --group-directories-first --icons=auto'
  alias lsa='ls -a'
  alias lt='eza --tree --level=2 --long --icons --git'
  alias lta='lt -a'
fi

alias ff="fzf --preview 'bat --style=numbers --color=always {}'"

open() {
  dms open "$@"
}

# Directories
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# Git
alias g='git'
alias gcm='git commit -m'
alias gcam='git commit -a -m'
alias gcad='git commit -a --amend'

if command -v mise &> /dev/null; then
  eval "$(mise activate bash)"
fi

# cd = zoxide: real paths work as usual, anything else jumps to a frequent
# folder (`cd proj`); `cdi` picks one interactively
if command -v zoxide &> /dev/null; then
  eval "$(zoxide init bash --cmd cd)"
fi

# fzf: Ctrl+R history, Ctrl+T file paths, Alt+C cd, and ** completion
if command -v fzf &> /dev/null; then
  eval "$(fzf --bash)"
fi

# Readline: case-insensitive completion, list matches on the first Tab,
# Up/Down search history for what's already typed.
# (One bind per line: `bind -f /dev/stdin` with a heredoc reads nothing on bash 5.3.)
bind 'set completion-ignore-case on'
bind 'set completion-prefix-display-length 2'
bind 'set show-all-if-ambiguous on'
bind 'set show-all-if-unmodified on'
bind '"\e[A": history-search-backward'
bind '"\e[B": history-search-forward'
bind 'set mark-symlinked-directories on'
bind 'set match-hidden-files off'
bind 'set page-completions off'
bind 'set completion-query-items 200'
bind 'set visible-stats on'
bind 'set skip-completed-text on'
bind 'set colored-stats on'

export BAT_THEME=ansi
# Zed in the desktop (--wait so git, sudoedit etc. wait for the file to close),
# vi on a TTY or over SSH
if [[ -n "$WAYLAND_DISPLAY" ]]; then
  export EDITOR="zed --wait"
else
  export EDITOR="vi"
fi
